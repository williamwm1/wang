# ====== 应用配置 / App config ======
PORT=3000
# 用于签发登录令牌的密钥，部署时请改成一长串随机字符 / Secret for signing login tokens. Change to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# SQLite 数据库文件路径 / SQLite database file path
DB_PATH=./data/app.sqlite

# ====== Square API 配置 ======
# 你的 Square Access Token（从 Square 开发者后台获取）/ Your Square access token
SQUARE_ACCESS_TOKEN=
# 环境：production（正式）或 sandbox（测试）/ Environment: production or sandbox
SQUARE_ENVIRONMENT=production
# 你的门店 Location ID（用于查询库存等）/ Your Square location ID
SQUARE_LOCATION_ID=
